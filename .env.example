# Elasticsearch Serverless project endpoint (Project settings -> "Elasticsearch endpoint")
ES_URL=https://your-project.es.us-east-1.aws.elastic.cloud:443
# Admin/ingest API key (encoded). The MCP server gets a separate read-only key (see README).
ES_API_KEY=

# balldontlie GOAT tier key (https://app.balldontlie.io)
BALLDONTLIE_API_KEY=

# Optional
INDEX_PREFIX=nba
# Leave blank to use the default semantic_text endpoint (ELSER on EIS)
SEMANTIC_INFERENCE_ID=
